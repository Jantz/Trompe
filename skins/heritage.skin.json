{
  "name": "heritage",
  "description": "Late-70s/80s home hi-fi and lab equipment: beige textured plastic, matte keys with chamfered edges, orange accents, green phosphor readouts. Tactile realism.",
  "colorScheme": "light",
  "tokens": {
    "color.canvas": "oklch(80% 0.03 80)",
    "color.surface": "oklch(89% 0.035 88)",
    "color.well": "oklch(84% 0.03 85)",
    "color.ink": "oklch(28% 0.035 55)",
    "color.ink-muted": "oklch(38% 0.035 55)",
    "color.edge": "oklch(51% 0.04 70)",
    "color.accent": "oklch(52% 0.16 45)",
    "color.accent-ink": "oklch(98% 0.01 80)",
    "color.focus": "oklch(48% 0.2 255)",
    "color.shadow": "oklch(28% 0.04 60)",
    "realism.default": 0.75,
    "light.angle": "320deg",
    "light.elevation": "52deg",
    "radius.sm": "2px",
    "radius.md": "3px",
    "radius.lg": "6px"
  },
  "elements": {
    "*": {
      "material": "plastic",
      "finish": "matte",
      "profile": "bevel",
      "vars": {
        "--tr-m-grain": "0.12"
      }
    },
    "tr-panel": {
      "material": "plastic",
      "finish": "matte",
      "profile": "flat",
      "vars": {
        "--tr-m-grain": "0.14"
      }
    },
    "tr-knob": {
      "material": "metal",
      "finish": "spun",
      "vars": {
        "--tr-m-base": "oklch(80% 0.01 80)"
      }
    },
    "tr-display": {
      "style": {
        "--tr-display-color": "oklch(80% 0.2 145)"
      }
    }
  }
}
